{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "iam": {
        "ClusterId": "iam",
        "Match": {
          "Path": "/iam/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/iam"
          }
        ]
      },
      "workmanagement": {
        "ClusterId": "workmanagement",
        "Match": {
          "Path": "/work/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/work"
          }
        ]
      }
    },
    "Clusters": {
      "iam": {
        "Destinations": {
          "iam": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "workmanagement": {
        "Destinations": {
          "workmanagement": {
            "Address": "http://localhost:5003/"
          }
        }
      }
    }
  }
}
